{
  "name": "@stricahq/cbors",
  "version": "1.0.4",
  "description": "cbor encoder and decoder with annotation",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "browser": {
    "stream": "./dist/stream.js"
  },
  "unpkg": "./dist/index.min.js",
  "jsdelivr": "./dist/index.min.js",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cbor",
    "strica",
    "cardano"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/StricaHQ/cbors.git"
  },
  "bugs": {
    "url": "https://github.com/StricaHQ/cbors/issues"
  },
  "homepage": "https://github.com/StricaHQ/cbors#readme",
  "scripts": {
    "docs": "rm -rf docs && typedoc",
    "build": "rm -rf dist && tsup && cp shims/index.mjs shims/index.d.mts dist/",
    "typecheck": "tsc --noEmit",
    "lint": "eslint 'src/**/*.ts'",
    "lint:fix": "eslint --fix 'src/**/*.ts'",
    "prepack": "yarn build",
    "prepublishOnly": "yarn build && yarn test",
    "test": "vitest run"
  },
  "author": "Strica",
  "license": "Apache-2.0",
  "dependencies": {
    "bignumber.js": "^9.3.0",
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.16",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.44.0",
    "@typescript-eslint/parser": "^8.44.0",
    "eslint": "^8.57.1",
    "eslint-config-airbnb-base": "^15.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^4.2.1",
    "lodash": "^4.17.21",
    "prettier": "^2.8.8",
    "readable-stream": "^4.7.0",
    "tsup": "^8.5.0",
    "typedoc": "^0.28.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.0"
  },
  "files": [
    "dist/**/*",
    "LICENSE",
    "README.md",
    "package.json"
  ]
}
